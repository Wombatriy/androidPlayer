.gradle
**/build/
!**/src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# NDK-generated intermediate files
**/.cxx/

# GPL Rubber Band sources checked out explicitly for local native experiments.
# See tools/dsp/prepare-rubberband.ps1
app/src/main/cpp/vendor/rubberband/
